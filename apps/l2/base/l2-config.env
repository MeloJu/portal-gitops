# Configuração não sensível da l2-api, virada em ConfigMap pelo configMapGenerator do Kustomize.
# O nome gerado leva um hash do conteúdo (l2-config-<hash>): mudar qualquer valor troca a
# referência no Deployment e a API reinicia sozinha. Com um ConfigMap fixo o pod continuaria
# com o valor antigo até alguém reiniciá-lo (aconteceu com o OTEL_SDK_DISABLED).
#
# O que é sensível (JWT_SECRET, senhas) vem do Secret `l2-secrets`, nunca daqui.

# O host `postgres` é o Service: DNS interno, nunca IP. O Flyway cria o schema no boot.
DB_URL=jdbc:postgresql://postgres:5432/l2
DB_USER=l2_app
# Cada overlay sobrescreve com o endereço público.
PUBLIC_BASE_URL=http://l2.localhost
# Cookie de sessão só por HTTPS; o overlay local desliga porque usa HTTP.
SESSION_COOKIE_SECURE=true
# O Spring só liga os grupos liveness/readiness sozinho ao detectar Kubernetes; explícito evita surpresa.
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
# Sem histograma o Prometheus só tem média de latência; com ele, p50/p95/p99 por rota.
# ATENÇÃO ao nome: a propriedade é `percentiles-histogram`, e em variável de ambiente o hífen
# some (PERCENTILESHISTOGRAM). Com `PERCENTILES_HISTOGRAM` o Spring entende `percentiles` (uma
# lista de números), recebe "true" e a API NÃO SOBE.
MANAGEMENT_METRICS_DISTRIBUTION_PERCENTILESHISTOGRAM_HTTP_SERVER_REQUESTS=true

# Agente OpenTelemetry (já vem na imagem, desligado por padrão): traces da API e do JDBC
# (as queries no Postgres viram spans filhos) para o Collector, que repassa ao Tempo.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=l2-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Continua o trace de quem chamou (Traefik, browser); sem pai, amostra tudo. Demo: 100%.
OTEL_TRACES_SAMPLER=parentbased_always_on
# Métricas vão pelo scrape do Prometheus (/actuator/prometheus); logs ficam no stdout.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
